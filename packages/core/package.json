{
  "name": "@sweberdev/inverse",
  "version": "0.2.0",
  "description": "Withdrawal button (§ 356a BGB) and cancellation button (§ 312k BGB) for any web app: validation, server-side receipt with date and time, acknowledgement e-mail, deadlines and a page checker. Includes a framework-free form for plain HTML via a <script> tag.",
  "license": "MIT",
  "author": "Seya Weber (https://github.com/sxwxbxr)",
  "homepage": "https://packages.sweber.dev/inverse/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weber-Development/inverse.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Weber-Development/inverse/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/inverse.global.js",
  "jsdelivr": "./dist/inverse.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "inverse": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "widerrufsbutton",
    "kuendigungsbutton",
    "widerruf",
    "kuendigung",
    "356a-bgb",
    "312k-bgb",
    "withdrawal-button",
    "cancellation-button",
    "consumer-law",
    "nextjs",
    "compliance",
    "wordpress",
    "shopify",
    "vanilla-js"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "jsdom": "^27.0.0"
  }
}
